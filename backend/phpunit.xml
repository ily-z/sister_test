<?xml version="1.0" encoding="UTF-8"?>
<!--
    CATATAN OUTPUT "deprecated"

    Di PHP 8.4+, konstanta PDO::MYSQL_ATTR_SSL_CA dideklarasikan deprecated.
    Laravel 11 masih memakainya di Illuminate\Database\Schema\MySqlSchemaState,
    jadi setiap test yang memakai RefreshDatabase akan memicu deprecation
    dari dalam vendor, bukan dari kode kita.

    Akibatnya `php artisan test` mencetak banyak baris "deprecated"
    meskipun semua test hijau. Ini murni derau dari versi PHP lokal.
    Jangan dibaca sebagai kegagalan; yang penting baris "Tests:" tidak
    mengandung "failed"/"error".

    Kalau deprecation ini benar-benar mengganggu (mis. CI diset dengan
    opsi fail-on-deprecation), upgrade ke versi Laravel yang sudah mendukung
    PHP 8.4. Jangan dipatch manual di vendor/.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="false"
         failOnNotice="false"
         failOnWarning="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            WAJIB: test memakai database terpisah. Feature test memakai
            RefreshDatabase, yang menjalankan migrate:fresh. Bila DB_DATABASE
            ikut menunjuk database development/production, seluruh data akan
            di-DROP setiap kali `php artisan test` dijalankan.

            SQLite tidak bisa dipakai karena migration
            2026_09_12_000002_create_roles_table memakai sintaks MySQL
            (ALTER TABLE ... MODIFY).
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="car_rent_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
