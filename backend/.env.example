# ═══════════════════════════════════════════════════════════════════════════
#  PRECISION FLEET — BACKEND (Laravel, server #2)
# ═══════════════════════════════════════════════════════════════════════════
#  File ini SALIN ke .env lalu sesuaikan. Salin juga .env.testing untuk
#  menjalankan phpunit (WAJIB: test memakai RefreshDatabase yang akan DROP
#  database — jangan pernah arahkan ke database produksi).
#
#  Nama environment di bawah memakai nilai yang benar-benar dipakai saat
#  deploy 3-server. Ganti hanya yang perlu.
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME="Precision Fleet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Sengaja tetap "en" seperti instalasi lama.
#
# PENTING: jangan set APP_FALLBACK_LOCALE=id tanpa menerbitkan folder
# lang/id/ dulu. Paket Laravel hanya menyertakan terjemahan "en", dan
# proyek ini tidak punya folder lang/. Kalau locale DAN fallback sama-sama
# "id", setiap pesan validasi tampil sebagai kunci mentah -- user melihat
# "validation.email", bukan bahasa Indonesia.
#
# Catatan: Carbon BISA memuat locale "id" dengan benar (nama bulan dan
# diffForHumans jadi bahasa Indonesia). Yang bermasalah adalah penerjemah
# Laravel, bukan Carbon. Nama bulan Indonesia dihitung di frontend
# (frontend/src/lib/format.js) supaya tampilan konsisten di semua halaman.
# Penjelasan lengkap: docs/KNOWN_ISSUES.md bagian 4.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Server addresses ───────────────────────────────────────────────────────
# FRONTEND_URL  -> origin server FRONTEND (server #1). Dipakai untuk:
#   * membuat link QR verifikasi yang dicetak di PDF invoice, dan
#   * mengizinkan CORS (kalau FRONTEND_ORIGINS tidak diisi, ini yang dipakai).
#
# FRONTEND_ORIGINS -> daftar origin yang diizinkan, dipisah koma. Isi "*"
#   kalau frontend memang harus bisa diakses dari IP address seadanya
#   (mis. http://10.0.0.5:8080). Kalau nanti sudah ada domain sendiri,
#   persempit ke domain itu saja:
#     FRONTEND_ORIGINS=https://app.royal-tour.co.id
#
# APP_URL harus menunjuk ke BACKEND yang bisa dijangkau user, karena
# signed URL file (/api/files/...) dibangun relatif terhadap APP_URL.
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=*

# IP / host proxy nginx yang berdiri di depan backend. Kosongkan (= percaya
# semua proxy) untuk jaringan internal; isi dengan IP proxy kalau backend
# di-expose ke internet, supaya rate limiter tidak salah menghitung IP.
TRUSTED_PROXIES=

# ── Auth token (Sanctum) ────────────────────────────────────────────────────
# Masa berlaku token Sanctum dalam menit. Default 480 = 8 jam, satu shift.
AUTH_API_TOKEN_TTL=480

# Masa berlaku signed URL file (/api/files/{path}) dalam detik.
# File di storage berisi foto KTP penyewa, jadi jangan terlalu lama.
FILE_URL_TTL=600

# ── Database (server #3) ───────────────────────────────────────────────────
# Untuk instalasi lokal, biarkan DB_HOST=127.0.0.1.
# Untuk 3-server sungguhan, isi IP private server database:
#     DB_HOST=10.0.0.3
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=car_rent
DB_USERNAME=root
DB_PASSWORD=

# ── Session ────────────────────────────────────────────────────────────────
# Database, bukan file: data session tidak hilang saat server di-restart,
# dan konsisten dengan CACHE_STORE / QUEUE_CONNECTION di bawah.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Filesystem ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ── Redis (opsional; hanya perlu bila nanti pakai queue asynchronous) ─────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ───────────────────────────────────────────────────────────────────
# Backend masih memakai Blade (template PDF invoice) dan masih punya
# @vite di beberapa view legacy. Untuk produksi, build sekali di server:
#     cd backend && npm ci && npm run build
VITE_APP_NAME="${APP_NAME}"