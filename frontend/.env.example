# ─────────────────────────────────────────────────────────────────────────────
#  Konfigurasi build SPA Precision Fleet
# ─────────────────────────────────────────────────────────────────────────────
#
#  File ini dibaca oleh Vite SAAT BUILD (npm run build), bukan saat aplikasi
#  berjalan. Nilainya dibakar permanen ke dalam file JavaScript di dist/.
#  Mengubah file ini setelah build tidak berefek apa pun -- harus build ulang.
#
#  Hanya variabel berawalan VITE_ yang terbaca oleh Vite. Jangan menaruh
#  kredensial / password / API key di sini: semua isi VITE_* masuk ke source
#  map dan bisa dibaca siapa saja yang punya akses ke file hasil build.
#
#  Detail lengkap tiap variabel ada di docs/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────


# ── Alamat API backend ──────────────────────────────────────────────────────
#
#  DUA PILIHAN. Pilih salah satu (A atau B), jangan isi keduanya.
#
#
#  (A) KOSONGKAN -- SPA memakai path relatif /api/... [REKOMENDASI]
#
#      SPA memanggil /api/... pada origin yang sama, lalu nginx di server
#      frontend meneruskannya ke backend.
#
#      Keuntungan:
#        - Tidak ada CORS sama sekali (request menjadi same-origin).
#        - Tidak ada preflight OPTIONS untuk tiap request yang method-nya
#          atau content-type-nya berbeda.
#        - IP backend tidak pernah terekspos ke browser pengguna.
#
#      Yang perlu diisi di server frontend (bukan di sini): blok
#      "location /api" yang proxy_pass ke http://IP_BACKEND:8000.
#      Contoh lengkap ada di docs/DEPLOY.md.
#
#
#  (B) ISI URL ABSOLUT -- SPA langsung memanggil backend
#
#      Dipakai hanya kalau konfigurasi nginx server frontend tidak bisa
#      diubah, mis. backend sudah berada di belakang reverse proxy milik
#      pihak lain yang tidak boleh disentuh.
#
#      Konsekuensi Mode B yang harus bluntly diterima:
#        - Semua request kena CORS. config/cors.php backend sudah diset
#          longgar, tetapi tidak menoleransi kesalahan header di reverse
#          proxy yang berada di depannya.
#        - Header Authorization + Content-Type: application/json membuat
#          browser mengirim preflight OPTIONS lebih dulu. Backend harus
#          menjawab OPTIONS dengan benar -- Laravel sudah melakukannya,
#          tapi jangan lupa mengecek header di proxy yang di depannya.
#        - IP backend menjadi terlihat oleh semua pengguna, jadi firewall
#          backend harus dikunci sedekat mungkin.
#
#      Contoh nilai:  http://10.0.0.2:8000
#      Contoh nilai:  https://api.precisionfleet.co.id
#
VITE_API_BASE_URL=


# ── Hanya untuk `npm run dev` ────────────────────────────────────────────────
#
#  Target proxy Vite saat pengembangan lokal. Tidak ikut ter-bundle ke dist/,
#  jadi boleh dikosongkan di server produksi.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000


# ── URL publik frontend (opsional) ───────────────────────────────────────────
#
#  Dipakai backend untuk membuat tautan verifikasi invoice yang tercetak di
#  PDF (QR code). Kalau dikosongkan, backend memakai FRONTEND_URL di
#  backend/.env -- bukan nilai ini. Nilai di sini hanya untuk dokumentasi.
VITE_FRONTEND_URL=